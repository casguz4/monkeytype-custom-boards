{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "all",
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "tabWidth": 4,
    "printWidth": 120,
    "embeddedLanguageFormatting": "auto",
    "experimentalSortImports": {
        "groups": [
            ["side-effect"],
            ["builtin"],
            ["external", "external-type"],
            ["internal", "internal-type"],
            ["parent", "parent-type"],
            ["sibling", "sibling-type"],
            ["index", "index-type"],
        ],
    },
    // Disabled: experimentalTailwindcss is incompatible with Tailwind v4 CSS-based config
    // and strips all className strings when it can't resolve the config.
    // Re-enable once oxfmt supports Tailwind v4.
    // "experimentalTailwindcss": {
    //     "stylesheet": "./app/app.css",
    //     "attributes": ["class", "className"],
    //     "functions": ["clsx", "cn"],
    //     "preserveDuplicates": false,
    //     "preserveWhitespace": false,
    // },
}
